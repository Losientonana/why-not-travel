# MySQL
MYSQL_ROOT_PASSWORD=변경필수
MYSQL_DATABASE=whynottravel
MYSQL_USER=travel
MYSQL_PASSWORD=변경필수

# Redis
REDIS_PASSWORD=변경필수

# Spring Boot DataSource
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/whynottravel?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=travel
SPRING_DATASOURCE_PASSWORD=변경필수

# Spring Boot Redis
SPRING_REDIS_HOST=redis-cache
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=변경필수

# JWT
JWT_SECRET=변경필수_64자이상의랜덤문자열

# Frontend URL (CORS)
FRONTEND_URL=https://whynottravel.xyz

# S3/MinIO (비활성화)
AWS_S3_ENABLED=false
MINIO_ENABLED=false

# Cookie
COOKIE_SECURE=true

# Mail (현재 비활성 상태 - 추후 설정)
MAIL_FROM_EMAIL=noreply@whynottravel.xyz

# OAuth2 (미설정 시 placeholder 사용됨 - 소셜로그인 비활성)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# MySQL
MYSQL_ROOT_PASSWORD=변경필수
MYSQL_DATABASE=whynottravel
MYSQL_USER=travel
MYSQL_PASSWORD=변경필수

# Redis
REDIS_PASSWORD=변경필수

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=변경필수

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/whynottravel?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=travel
SPRING_DATASOURCE_PASSWORD=변경필수
SPRING_REDIS_HOST=redis-cache
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=변경필수

# JWT
JWT_SECRET=변경필수_64자이상의랜덤문자열

# MinIO (Spring에서 사용)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=변경필수

# Frontend URL (CORS용)
FRONTEND_URL=https://whynottravel.xyz,https://www.whynottravel.xyz

# OAuth2 (기존 값 유지)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

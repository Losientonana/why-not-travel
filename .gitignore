# ========================================
# Spring Boot 설정 파일 (프로필별 설정은 커밋 허용)
# ========================================
# 공통 설정 파일과 프로필별 설정은 Git에 포함
# application.properties (공통 설정)
# application-local.properties (로컬 개발)
# application-blue.properties (Blue 서버)
# application-green.properties (Green 서버)
# 단, 백업 파일은 제외
backend/src/main/resources/*backup*.properties

# ========================================
# Git 관련
# ========================================
.bfg-report/
*.bfg-repo-id
.git-credentials

# ========================================
# Docker (로컬 볼륨 데이터)
# ========================================
# Docker 설정 파일은 Git에 포함
# Dockerfile, docker-compose.yml은 커밋됨
*-data/
mysql-data/
redis-data/
minio-data/

# ========================================
# AI 생성 문서들 (선택적)
# ========================================
